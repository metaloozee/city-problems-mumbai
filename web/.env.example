# Copy to web/.env.local for local development, and set the same variables in Vercel → Project → Settings → Environment Variables.
# Neon connection string (Neon console → Connect → "Pooled connection"). Without it, `npm run dev` uses a local PGlite database
# and the deployed site saves resident reports on each visitor's device only.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"
# Any long random string. Salts the hash used to rate-limit reports and de-duplicate "I face this too" votes.
REPORTER_SALT="change-me"
